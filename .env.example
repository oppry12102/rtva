# Copy to .env and fill in. .env is gitignored.
MINIMAX_API_KEY=sk-...your-key...
MINIMAX_BASE_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2

# Service
HOST=0.0.0.0
PORT=8095

# Pipeline (defaults are tuned against measured latency ~4s/call)
WORKERS=4
WINDOW_SECONDS=1.5
TARGET_FPS=8
FAST_MAX_FRAMES=8
FAST_RESOLUTION=448x252
ESCALATE_MAX_FRAMES=20
ESCALATE_RESOLUTION=672x378

# Backpressure ladder triggers (queue depth)
BP_L1=4
BP_L2=8
BP_L3=12

# LLM
REQUEST_TIMEOUT_S=20
MAX_RETRY=2

# Auth (v1 public API). AUTH_DISABLED=true bypasses all bearer checks (dev only).
TOKEN_STORE=data/tokens.json
AUTH_DISABLED=false

# KCP channel (low-jitter UDP transport for external Android apps)
KCP_HOST=0.0.0.0
KCP_PORT=8096
KCP_ENABLED=true
